<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>스토어 | BOTANICA LAB</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <header>
        <div>
            <h1>BOTANICA LAB</h1>
            <p>YOUR SPACE, YOUR PLANT.</p>
        </div>

        <nav>
            <a href="/">홈</a>
            <a href="/plants">식물 도감</a>
            <a href="/recommend">식물 추천</a>
            <a href="/care">식물 관리</a>
            <a href="/shop">스토어</a>
        </nav>
    </header>

    <main>
        <h2>BOTANICA STORE</h2>
        <p>당신의 공간에 작은 자연을 더해보세요.</p>

        <section class="plant-list">
            <% products.forEach(function(product) { %>
                <article>
                    <img src="/images/<%= product.image %>" alt="<%= product.name %>">
                    <h3><%= product.name %></h3>
                    <p><%= product.description %></p>
                    <p><%= product.price.toLocaleString() %>원</p>
                </article>
            <% }); %>
        </section>
    </main>

</body>
</html>
